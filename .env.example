# ==========================================
# Core AI & Application Config (Server-Side)
# ==========================================
# Google Gemini API Key for AI wardrobe cataloging, color harmony & outfit coordination
GEMINI_API_KEY=""

# The public domain or URL where your app is hosted (e.g., https://vastrakalp.yourdomain.com)
APP_URL="https://yourdomain.com"

# Server Port (Defaults to 3000 or dynamically set by host like Cloud Run, Railway, Render)
PORT=3000
NODE_ENV="production"

# ==========================================
# Firebase Client Configuration (Optional if firebase-applet-config.json is present)
# ==========================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_DATABASE_ID=""

# ==========================================
# Firebase Admin / Server Configuration
# ==========================================
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_ID=""
# Path to service account JSON key file (if running outside GCP/Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/serviceAccountKey.json"

