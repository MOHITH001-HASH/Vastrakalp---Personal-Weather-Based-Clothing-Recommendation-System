# Python API
GEMINI_API_KEY=replace-with-your-gemini-api-key
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
FIREBASE_DATABASE_ID=replace-with-firestore-database-id
PORT=8000
# Comma-separated browser origins. Vercel's same-origin API does not need this.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Vercel only: store the full Firebase Admin service-account JSON as a protected
# environment variable. Do not commit the real value. Cloud Run should use its
# attached service account instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Local Firebase Admin credentials (optional; use Application Default
# Credentials where possible). Never commit a service-account key file.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# React/Vite client configuration. These VITE_* values are public and are
# embedded in the browser bundle; they are not server secrets. The checked-in
# firebase-applet-config.json is used as a fallback.
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_ID=(default)
